{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": false,
    "share": "disabled",
    "enabled_providers": ["azure", "azure-anthropic", "ollama"],
    "model": "{env:EXPERIGEN_ANALYST_MODEL}",
    "small_model": "{env:EXPERIGEN_ANALYST_MODEL}",
    "compaction": {"auto": true, "prune": true, "reserved": 8192},
    "permission": {
        "*": "allow",
        "question": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny",
        "edit": {"*": "allow", "*.csv": "deny"}
    },
    "agent": {
        "feature-lookup": {
            "model": "{env:EXPERIGEN_ANALYST_MODEL}",
            "steps": 16
        },
        "build": {
            "mode": "primary",
            "steps": 32,
            "tools": {
                "write": true,
                "edit": true,
                "bash": true,
                "read": true,
                "grep": true,
                "glob": true,
                "feature_extractor": true,
                "feature_search": false
            }
        },
        "general": {"steps": 32},
        "explore": {"steps": 32}
    },
    "provider": {
        "azure": {
            "npm": "@ai-sdk/azure",
            "options": {
                "baseURL": "{env:AZURE_OPENAI_BASE_URL}",
                "apiKey": "{env:AZURE_API_KEY}",
                "apiVersion": "2025-03-01-preview"
            },
            "models": {
                "gpt-5.6-terra": {
                    "name": "gpt-5.6-terra",
                    "limit": {"context": 65536, "output": 4096}
                }
            }
        },
        "azure-anthropic": {
            "name": "Azure AI Foundry (Anthropic)",
            "npm": "@ai-sdk/anthropic",
            "api": "https://mdsr-foundry-resource.services.ai.azure.com/anthropic/v1",
            "env": ["AZURE_API_KEY"],
            "models": {
                "claude-sonnet-4-5": {
                    "id": "claude-sonnet-4-5",
                    "name": "Claude Sonnet 4.5",
                    "tool_call": true,
                    "attachment": true,
                    "reasoning": true,
                    "temperature": true,
                    "options": {
                        "thinking": {
                            "type": "enabled",
                            "budgetTokens": 16000
                        }
                    }
                },
                "claude-haiku-4-5": {
                    "id": "claude-haiku-4-5",
                    "name": "Claude Haiku 4.5",
                    "tool_call": true,
                    "attachment": true,
                    "reasoning": true,
                    "temperature": true,
                    "options": {
                        "thinking": {
                            "type": "enabled",
                            "budgetTokens": 16000
                        }
                    }
                }
            }
        },
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama",
            "options": {
                "baseURL": "http://localhost:7000/v1"
            },
            "models": {
                "Qwen/Qwen3-32B": {
                    "name": "Qwen/Qwen3.5-9B",
                    "limit": {
                        "context": 20000,
                        "output": 5000
                    }
                }
            }
        }
    }
}