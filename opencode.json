{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": false,
    "share": "disabled",
    "enabled_providers": [
        "azure",
        "azure-anthropic",
        "ollama"
    ],
    "model": "{env:EXPERIGEN_ANALYST_MODEL}",
    "small_model": "{env:EXPERIGEN_ANALYST_MODEL}",
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 8192
    },
    "permission": {
        "*": "allow",
        "question": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny",
        "edit": {
            "*": "allow",
            "*.csv": "deny"
        }
    },
    "agent": {
        "feature-lookup": {
            "model": "{env:EXPERIGEN_ANALYST_MODEL}",
            "steps": 16
        },
        "build": {
            "mode": "primary",
            "steps": 32,
            "tools": {
                "write": true,
                "edit": true,
                "bash": true,
                "read": true,
                "grep": true,
                "glob": true,
                "feature_extractor": true,
                "feature_search": false
            }
        },
        "general": {
            "steps": 32
        },
        "explore": {
            "steps": 32
        }
    },
    "provider": {
        "azure": {
            "npm": "@ai-sdk/azure",
            "options": {
                "baseURL": "{env:AZURE_OPENAI_BASE_URL}",
                "apiKey": "{env:AZURE_API_KEY}",
                "apiVersion": "v1"
            },
            "models": {
                "gpt-5.4": {
                    "name": "gpt-5.4",
                    "tool_call": true,
                    "reasoning": true,
                    "limit": {
                        "context": 200000,
                        "output": 32000
                    }
                },
                "gpt-5.4-mini": {
                    "name": "gpt-5.4-mini",
                    "tool_call": true,
                    "reasoning": true,
                    "limit": {
                        "context": 200000,
                        "output": 32000
                    }
                },
                "gpt-5.6-terra": {
                    "name": "gpt-5.6-terra",
                    "tool_call": true,
                    "reasoning": true,
                    "limit": {
                        "context": 200000,
                        "output": 32000
                    }
                }
            }
        },
        "azure-anthropic": {
            "name": "Azure AI Foundry (Anthropic)",
            "npm": "@ai-sdk/anthropic",
            "api": "{env:AZURE_ANTHROPIC_API_BASE}/v1",
            "env": [
                "AZURE_API_KEY"
            ],
            "models": {
                "claude-sonnet-5-5": {
                    "name": "claude-sonnet-5-5",
                    "tool_call": true,
                    "reasoning": true,
                    "limit": {
                        "context": 200000,
                        "output": 32000
                    },
                    "id": "claude-sonnet-5-5",
                    "attachment": true
                },
                "claude-opus-4-7": {
                    "name": "claude-opus-4-7",
                    "tool_call": true,
                    "reasoning": true,
                    "limit": {
                        "context": 200000,
                        "output": 32000
                    },
                    "id": "claude-opus-4-7",
                    "attachment": true
                },
                "claude-haiku-4-5": {
                    "name": "claude-haiku-4-5",
                    "tool_call": true,
                    "reasoning": true,
                    "limit": {
                        "context": 200000,
                        "output": 32000
                    },
                    "id": "claude-haiku-4-5",
                    "attachment": true
                }
            },
            "options": {
                "baseURL": "{env:AZURE_ANTHROPIC_API_BASE}/v1",
                "apiKey": "{env:AZURE_API_KEY}"
            }
        },
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama",
            "options": {
                "baseURL": "http://localhost:7000/v1"
            },
            "models": {
                "Qwen/Qwen3-32B": {
                    "name": "Qwen/Qwen3.5-9B",
                    "limit": {
                        "context": 20000,
                        "output": 5000
                    }
                }
            }
        }
    }
}
